<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Forget_Password_Activity"
    android:gravity="center"
    android:padding="20dp"
    android:background="#ffffff">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" Back to Login"
                android:textColor="#0D47A1"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="15dp"
                android:textStyle="bold"
                android:id="@+id/tvForgetPasswordBackToLogin"
                android:drawableLeft="@drawable/lock"
                android:textSize="16dp"/>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/lock"
                android:padding="30dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/circle_background"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:layout_marginTop="3dp"
                android:textColor="@color/black"
                android:textSize="25dp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginLeft="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please enter your details below to securely"
                android:layout_marginLeft="50dp"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginTop="1dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="reset your account password."
                android:textColor="@color/black"
                android:textSize="16dp"
                android:gravity="center"/>


            <androidx.cardview.widget.CardView
                android:layout_width="350dp"
                android:layout_height="380dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"

                android:background="#FFFFFF"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="31dp"
                        android:drawableLeft="@drawable/username"
                        android:text="Username"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etForgetPasswordUsername"
                        android:layout_width="320dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/edittext_bg"
                        android:hint="Username"
                        android:textSize="14dp"
                        android:textColorHint="#6F6F6F"
                        android:inputType="text"
                        android:textColor="@color/black" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="20dp"
                        android:drawableLeft="@drawable/lock"
                        android:text="New Password"
                        android:textColor="@color/black"
                        android:textSize="16sp" />


                    <EditText
                        android:id="@+id/etForgetPasswordNewPassword"
                        android:layout_width="320dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/edittext_bg"
                        android:hint="New Password"
                        android:textColorHint="#6F6F6F"
                        android:textSize="14dp"
                        android:inputType="textPassword"
                        android:textColor="@color/black" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="20dp"
                        android:drawableLeft="@drawable/password"
                        android:text="Confirm Password"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/etForgetPasswordConfirmPassword"
                        android:layout_width="320dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/edittext_bg"
                        android:textSize="14dp"
                        android:hint="Confirm Password"
                        android:textColorHint="#6F6F6F"
                        android:inputType="textPassword"
                        android:textColor="@color/black" />

                    <Button
                        android:id="@+id/btnForgetPasswordReset"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="#0D47A1"
                        android:text="Reset Password"
                        android:textColor="@color/white" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="30dp"
                    android:text="Remember your password ? "
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Login now"
                    android:textColor="#0D47A1"
                    android:textStyle="bold"
                    android:id="@+id/tvLoginUser"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:textSize="15dp"
                android:textColor="#6F6F6F"
                android:layout_marginBottom="40dp"
                android:text="Need help? \nContact Support: support@eduvoiceindia.org"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>